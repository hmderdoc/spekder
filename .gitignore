# Build artifacts (anchored: the binaries share names with the repo, so anchor
# to the repo root rather than ignoring a like-named source file anywhere).
/spekder
/spekder.exe
/spekder-server
/spekder-server.exe
/balancesim
/dist/

# Legacy binary names (kept on disk for an in-place install, never committed).
/door
/server

# Runtime / per-install (spekder.ini.example is committed; the live config is not)
/spekder.log
/door.log
/spekder.ini
/door.ini

# Runtime data dirs (per-user settings, editor saves, server's published maps).
# Anchored so a like-named source dir elsewhere isn't ignored.
/data/
/usermaps/
/maps/

# Server's live boards (built per-install from play, not source).
/scores.json
/players.json
