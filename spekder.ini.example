# Spekder door config. Copy to "spekder.ini" next to the door binary to enable
# networked multiplayer. With NO spekder.ini (or no "server" line), the door
# runs LOCAL single-player against bots -- so an unconfigured install just works.
# (The legacy name "door.ini" is also still read, for older installs.)
#
# Read at launch, so edits apply to the next caller with no BBS restart.

# Source-board name shown on the GLOBAL high-score table next to your players, so
# scores from different BBSes are distinguishable. Defaults to the DOOR32 BBS id.
# When "server" is set, finished matches (single-player too) submit to the board.
# bbsname = Cheese BBS

# Arena server to connect to. Remove/comment "server" for offline play.
# If set but unreachable, the door waits briefly then falls back to local play.
server = futureland.today
port   = 7700
token  = c5749f8ef3daa48167f469e1580eb388

# Pin OFFLINE single-player to one map by name or index (no rotation). Handy for
# testing a specific layout; online play uses the arena server's map. The
# SPEKDER_MAP env var overrides this if set. Omit for normal random/rotating maps.
# map = REDOUBT
